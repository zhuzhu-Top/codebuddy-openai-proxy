# Optional credential overrides. Normally the proxy reads the current
# Windows user's logged-in CodeBuddy session automatically.
CODEBUDDY_ACCESS_TOKEN=
CODEBUDDY_DEVICE_TOKEN=
CODEBUDDY_USER_ID=
CODEBUDDY_ENTERPRISE_ID=
CODEBUDDY_DOMAIN=

# Optional proxy settings.
CODEBUDDY_UPSTREAM=https://copilot.tencent.com/v2/chat/completions
CODEBUDDY_CONFIG_URL=https://copilot.tencent.com/v3/config
# Used only if dynamic discovery is unavailable.
CODEBUDDY_MODELS=custom:gpt-5.6-sol|gpt-5.6-sol,kimi-k2-instruct-taiji
CODEBUDDY_TIMEOUT=600
CODEBUDDY_CONNECT_TIMEOUT=30
CODEBUDDY_MAX_REQUEST_BYTES=10485760
CODEBUDDY_MAX_CONCURRENCY=8

HOST=127.0.0.1
PORT=8765
